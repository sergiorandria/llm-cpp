{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "llm-cpp model config",
  "type": "object",
  "properties": {
    "vocab_size": { "type": "integer", "minimum": 1 },
    "n_layers": { "type": "integer", "minimum": 1 },
    "n_heads": { "type": "integer", "minimum": 1 },
    "n_embd": { "type": "integer", "minimum": 1 },
    "block_size": { "type": "integer", "minimum": 1 },
    "dropout": { "type": "number", "minimum": 0, "maximum": 1 },
    "rope_scaling": { "type": "number", "minimum": 1.0 },
    "global_every": { "type": "integer", "minimum": 1 }
  },
  "required": ["vocab_size", "n_layers", "n_heads", "n_embd", "block_size"],
  "allOf": [
    { "description": "n_heads must divide n_embd (checked by validate_config_verbose)" },
    { "description": "use_alibi and RoPE are mutually exclusive (checked by validate_config_verbose)" }
  ]
}
